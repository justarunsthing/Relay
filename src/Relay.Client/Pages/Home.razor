@page "/boards"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject HttpClient Http
@using Relay.Shared.Boards

<PageTitle>Boards</PageTitle>

<div class="list-head">
    <h1>Your boards</h1>
    <button type="button" @onclick="OpenCreate">New board</button>
</div>
@if (!string.IsNullOrEmpty(error) && !creatingOpen)
{
    <p class="error" role="alert">@error</p>
}

@if (boards is null)
{
    <p class="status">Loading…</p>
}
else if (boards.Count == 0)
{
    <p class="status">No boards yet.</p>
}
else
{
    <ul class="board-grid">
        @foreach (var board in boards)
        {
            <li>
                <a href="@($"/boards/{board.Id}")">
                    <span class="mini-lanes" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="board-name">@board.Name</span>
                    <time datetime="@board.CreatedAt.ToString("O")">Created @board.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")</time>
                </a>
            </li>
        }
    </ul>
}

@if (creatingOpen)
{
    <div class="modal-backdrop" @onclick="CloseCreate">
        <form class="modal" role="dialog" aria-modal="true" aria-labelledby="new-board-title" @onclick:stopPropagation="true" @onkeydown="OnDialogKey" @onsubmit="Create" @onsubmit:preventDefault="true">
            <h2 id="new-board-title">New board</h2>
            @if (!string.IsNullOrEmpty(error))
            {
                <p class="error" role="alert">@error</p>
            }
            <label>
                Board title
                <input @bind="name" @bind:event="oninput" maxlength="80" required autofocus />
            </label>
            <div class="modal-actions">
                <button type="button" class="quiet" @onclick="CloseCreate" disabled="@creating">Cancel</button>
                <button type="submit" disabled="@creating">Create board</button>
            </div>
        </form>
    </div>
}

@code {
    private List<BoardSummaryResponse>? boards;
    private string name = string.Empty;
    private string? error;
    private bool creating;
    private bool creatingOpen;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        boards = await Http.GetFromJsonAsync<List<BoardSummaryResponse>>("api/boards");
    }

    private void OpenCreate()
    {
        error = null;
        name = string.Empty;
        creatingOpen = true;
    }

    private void CloseCreate()
    {
        if (!creating)
        {
            creatingOpen = false;
            error = null;
        }
    }

    private void OnDialogKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseCreate();
        }
    }

    private async Task Create()
    {
        error = null;
        creating = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/boards", new CreateBoardRequest(name));
            if (!response.IsSuccessStatusCode)
            {
                error = await Relay.Client.Auth.ApiErrors.ReadAsync(response);
                return;
            }

            name = string.Empty;
            creatingOpen = false;
            await LoadAsync();
        }
        finally
        {
            creating = false;
        }
    }
}
