@page "/boards/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@implements Relay.Client.Boards.IBoardListener
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject RelayAuthenticationStateProvider Auth
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using Relay.Client.Boards
@using Relay.Shared.Boards
@using Relay.Shared.Cards
@using Relay.Shared.Hubs

<PageTitle>@(board?.Name ?? "Board")</PageTitle>

@if (missing)
{
    <h1>Board</h1>
    <p class="status">This board was not found.</p>
}
else if (!string.IsNullOrEmpty(loadError))
{
    <h1>Board</h1>
    <p class="error" role="alert">@loadError</p>
}
else if (board is null)
{
    <h1>Board</h1>
    <p class="status">Loading…</p>
}
else
{
    <h1>@board.Name</h1>

    @if (_reconnecting)
    {
        <p class="banner" role="status">Reconnecting…</p>
    }
    else if (_liveStopped)
    {
        <p class="banner" role="status">Live updates stopped.</p>
    }
    @if (people.Count > 0)
    {
        <ul class="presence" aria-label="On this board">
            @foreach (var person in people)
            {
                <li>
                    <span class="avatar" aria-hidden="true">@Initial(person.DisplayName)</span>
                    <span>@person.DisplayName</span>
                </li>
            }
        </ul>
    }
    @if (!string.IsNullOrEmpty(liveError))
    {
        <p class="error" role="alert">@liveError</p>
    }
    @if (!string.IsNullOrEmpty(moveError))
    {
        <p class="error" role="alert">@moveError</p>
    }
    @if (!string.IsNullOrEmpty(cardError) && _formColumnId is null && _deleteId is null)
    {
        <p class="error" role="alert">@cardError</p>
    }

    <div class="columns" data-board aria-busy="@_moving">
        @foreach (var column in board.Columns.OrderBy(column => column.Order))
        {
            <section class="column" data-column-id="@column.Id">
                <div class="column-head">
                    <h2>@column.Title</h2>
                    <button type="button" class="icon" aria-label="Add card" @onclick="() => OpenAdd(column.Id)">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 2.25a.75.75 0 0 1 .75.75v4.25H13a.75.75 0 0 1 0 1.5H8.75V13a.75.75 0 0 1-1.5 0V8.75H3a.75.75 0 0 1 0-1.5h4.25V3A.75.75 0 0 1 8 2.25"/></svg>
                    </button>
                </div>
                <ol>
                    @foreach (var card in column.Cards.OrderBy(card => card.Order))
                    {
                        <li class="card" draggable="true" data-card-id="@card.Id">
                            <div class="card-top">
                                <h3>@card.Title</h3>
                                <div class="card-tools">
                                    <button type="button" class="icon" aria-label="Edit card" @onclick="() => OpenEdit(card)">
                                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M11.01 1.34a1.6 1.6 0 0 1 2.26 0l1.39 1.39a1.6 1.6 0 0 1 0 2.26L6.4 13.25a1.6 1.6 0 0 1-.72.42l-2.55.64a.75.75 0 0 1-.91-.91l.64-2.55c.08-.3.23-.57.42-.72l8.73-8.79zM12.2 2.4 3.9 10.7l-.35 1.4 1.4-.35 8.3-8.3-1.05-1.05z"/></svg>
                                    </button>
                                    <button type="button" class="icon" aria-label="Delete card" @onclick="() => OpenDelete(card)">
                                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M6.25 1.75h3.5a.75.75 0 0 1 0 1.5h-3.5a.75.75 0 0 1 0-1.5zM2.5 4.25A.75.75 0 0 1 3.25 3.5h9.5a.75.75 0 0 1 0 1.5h-.28l-.62 7.4A1.75 1.75 0 0 1 10.11 14H5.89a1.75 1.75 0 0 1-1.74-1.6l-.62-7.4H3.25a.75.75 0 0 1-.75-.75z"/></svg>
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(card.Description))
                            {
                                <p>@card.Description</p>
                            }
                        </li>
                    }
                </ol>

                @if (column.Cards.Count == 0)
                {
                    <p class="empty">No cards</p>
                }
            </section>
        }
    </div>

    @if (_formColumnId is Guid formColumnId)
    {
        <div class="modal-backdrop" @onclick="CloseCardForm">
            <form class="modal" role="dialog" aria-modal="true" aria-labelledby="card-dialog-title" @onclick:stopPropagation="true" @onkeydown="OnDialogKey" @onsubmit="() => SubmitCardForm(formColumnId)" @onsubmit:preventDefault="true">
                <h2 id="card-dialog-title">@(_formCardId is null ? "New card" : "Edit card")</h2>
                @if (!string.IsNullOrEmpty(cardError))
                {
                    <p class="error" role="alert">@cardError</p>
                }
                <label>
                    Title
                    <input @bind="_formTitle" @bind:event="oninput" maxlength="120" required autofocus />
                </label>
                <label>
                    Description
                    <textarea @bind="_formDescription" @bind:event="oninput" maxlength="2000"></textarea>
                </label>
                <div class="modal-actions">
                    <button type="button" class="quiet" @onclick="CloseCardForm" disabled="@_saving">Cancel</button>
                    <button type="submit" disabled="@_saving">@(_formCardId is null ? "Add card" : "Save")</button>
                </div>
            </form>
        </div>
    }

    @if (_deleteId is Guid deleteId)
    {
        <div class="modal-backdrop" @onclick="CloseDelete">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title" @onclick:stopPropagation="true" @onkeydown="OnDialogKey">
                <h2 id="delete-dialog-title">Delete this card?</h2>
                @if (!string.IsNullOrEmpty(cardError))
                {
                    <p class="error" role="alert">@cardError</p>
                }
                <p class="modal-copy">@_deleteTitle</p>
                <div class="modal-actions">
                    <button type="button" class="quiet" @onclick="CloseDelete" disabled="@_saving" autofocus>Cancel</button>
                    <button type="button" class="danger" @onclick="() => DeleteCard(deleteId)" disabled="@_saving">Delete</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private BoardResponse? board;
    private bool missing;
    private string? loadError;
    private string? liveError;
    private string? moveError;
    private string? cardError;
    private IReadOnlyList<BoardUser> people = [];
    private bool _moving;
    private bool _saving;
    private Guid? _formColumnId;
    private Guid? _formCardId;
    private string _formTitle = "";
    private string _formDescription = "";
    private Guid? _deleteId;
    private string _deleteTitle = "";
    private bool _moveConfirmed;
    private bool _reconnecting;
    private bool _liveStopped;
    private int _serverStamp;
    private bool _disposed;
    private bool _dragReady;
    private Guid _loadedId;
    private Guid _activeCard;
    private BoardConnection? _live;
    private CancellationTokenSource? _liveCts;
    private Task? _liveTask;
    private DotNetObjectReference<Board>? _self;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        await StopLiveAsync();
        await StopDragAsync();

        _loadedId = Id;
        missing = false;
        loadError = null;
        liveError = null;
        moveError = null;
        cardError = null;
        _formColumnId = null;
        _formCardId = null;
        _deleteId = null;
        _reconnecting = false;
        _liveStopped = false;
        people = [];
        board = null;

        var response = await Http.GetAsync($"api/boards/{Id}");

        if (_disposed || _loadedId != Id)
        {
            return;
        }

        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            missing = true;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            loadError = await Relay.Client.Auth.ApiErrors.ReadAsync(response);
            return;
        }

        board = await response.Content.ReadFromJsonAsync<BoardResponse>();

        if (_disposed || _loadedId != Id || board is null)
        {
            return;
        }

        _liveTask = StartLiveAsync();
        await _liveTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (board is null || _dragReady || _disposed)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("relayDrag.start", _self);
        _dragReady = true;
    }

    [JSInvokable]
    public async Task OnCardDropped(string cardIdText, string columnIdText, int index)
    {
        if (_moving || _disposed || board is null
            || !Guid.TryParse(cardIdText, out var cardId)
            || !Guid.TryParse(columnIdText, out var columnId))
        {
            return;
        }

        if (AlreadyThere(board, cardId, columnId, index))
        {
            moveError = null;
            StateHasChanged();
            return;
        }

        var snapshot = board;
        var stamp = _serverStamp;
        _moving = true;
        _moveConfirmed = false;
        _activeCard = cardId;
        moveError = null;

        var optimistic = BoardView.OptimisticMove(board, cardId, columnId, index);

        if (optimistic is not null)
        {
            board = BoardView.ApplyOrders(board, optimistic.Orders);
            StateHasChanged();
        }

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/cards/{cardId}/move",
                new MoveCardRequest(columnId, index));

            if (_disposed || _loadedId != Id)
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                if (!_moveConfirmed && stamp == _serverStamp)
                {
                    board = snapshot;
                    moveError = await Relay.Client.Auth.ApiErrors.ReadAsync(response);
                }

                return;
            }

            var move = await response.Content.ReadFromJsonAsync<MoveCardResponse>();

            if (move is null)
            {
                if (!_moveConfirmed && stamp == _serverStamp)
                {
                    board = snapshot;
                    moveError = "The card could not be moved.";
                }

                return;
            }

            ApplyMove(move);
        }
        catch (HttpRequestException)
        {
            if (!_disposed && !_moveConfirmed && _loadedId == Id && stamp == _serverStamp)
            {
                board = snapshot;
                moveError = "The card could not be moved.";
            }
        }
        finally
        {
            _moving = false;

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    public Task OnBoardState(BoardResponse state, IReadOnlyList<BoardUser> users) =>
        InvokeAsync(() =>
        {
            if (_disposed || state.Id != Id)
            {
                return;
            }

            people = users;
            board = state;
            missing = false;
            _serverStamp++;
            StateHasChanged();
        });

    public Task OnReconnecting() =>
        InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _reconnecting = true;
            _liveStopped = false;
            StateHasChanged();
        });

    public Task OnReconnected() =>
        InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _reconnecting = false;
            _liveStopped = false;
            liveError = null;
            StateHasChanged();
        });

    public Task OnConnectionClosed() =>
        InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _reconnecting = false;
            _liveStopped = true;
            StateHasChanged();
        });

    public Task OnUserJoined(UserJoined joined) =>
        InvokeAsync(() =>
        {
            if (_disposed || joined.BoardId != Id || people.Any(person => person.UserId == joined.User.UserId))
            {
                return;
            }

            people = people
                .Append(joined.User)
                .OrderBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(person => person.UserId, StringComparer.Ordinal)
                .ToList();
            StateHasChanged();
        });

    public Task OnUserLeft(UserLeft left) =>
        InvokeAsync(() =>
        {
            if (_disposed || left.BoardId != Id)
            {
                return;
            }

            var remaining = people.Where(person => person.UserId != left.UserId).ToList();

            if (remaining.Count == people.Count)
            {
                return;
            }

            people = remaining;
            StateHasChanged();
        });

    public Task OnCardAdded(CardAdded added) =>
        InvokeAsync(() => ApplyCard(current => BoardView.Add(current, added)));

    public Task OnCardUpdated(CardUpdated updated) =>
        InvokeAsync(() => ApplyCard(current => BoardView.Update(current, updated)));

    public Task OnCardDeleted(CardDeleted deleted) =>
        InvokeAsync(() => ApplyCard(current => BoardView.Delete(current, deleted)));

    public Task OnCardMoved(MoveCardResponse move) =>
        InvokeAsync(() =>
        {
            if (_moving && move.CardId == _activeCard)
            {
                _moveConfirmed = true;
            }

            ApplyMove(move);
        });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await StopLiveAsync();
        await StopDragAsync();
    }

    private void ApplyMove(MoveCardResponse move)
    {
        var basis = board;

        if (basis is null)
        {
            return;
        }

        ApplyCard(_ => BoardView.ApplyOrders(basis, move.Orders));
    }

    private void ApplyCard(Func<BoardResponse, BoardResponse> apply)
    {
        if (_disposed || board is null || board.Id != Id)
        {
            return;
        }

        board = apply(board);
        StateHasChanged();
    }

    private async Task StartLiveAsync()
    {
        if (_disposed || board is null)
        {
            return;
        }

        _liveCts = new CancellationTokenSource();
        var live = new BoardConnection(Nav.ToAbsoluteUri("/hubs/board"), AccessTokenAsync, Id, this);
        _live = live;

        try
        {
            await live.StartAsync(_liveCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex) when (ex is HubException or HttpRequestException or InvalidOperationException)
        {
            if (!_disposed && _loadedId == Id)
            {
                liveError = "Live updates could not start.";
                StateHasChanged();
            }
        }
    }

    private async Task<string?> AccessTokenAsync()
    {
        await Auth.EnsureLoadedAsync();
        return Auth.Token;
    }

    private async Task StopLiveAsync()
    {
        var pending = _liveTask;
        var cts = _liveCts;
        var live = _live;
        _liveTask = null;
        _liveCts = null;
        _live = null;

        if (cts is not null)
        {
            await cts.CancelAsync();
        }

        if (pending is not null)
        {
            try
            {
                await pending;
            }
            catch (OperationCanceledException)
            {
            }
        }

        if (live is not null)
        {
            await live.DisposeAsync();
        }

        cts?.Dispose();
    }

    private async Task StopDragAsync()
    {
        if (!_dragReady)
        {
            _self?.Dispose();
            _self = null;
            return;
        }

        _dragReady = false;

        try
        {
            await JS.InvokeVoidAsync("relayDrag.stop");
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
        _self = null;
    }

    private async Task AddCard(Guid columnId)
    {
        if (_saving || _disposed || board is null)
        {
            return;
        }

        var title = _formTitle;
        var description = _formDescription;
        var stamp = _serverStamp;
        _saving = true;
        cardError = null;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/boards/{Id}/cards",
                new { columnId, title, description });

            if (_disposed || _loadedId != Id)
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                cardError = await Relay.Client.Auth.ApiErrors.ReadAsync(response);
                return;
            }

            var card = await response.Content.ReadFromJsonAsync<CardResponse>();

            if (card is null)
            {
                cardError = "The card could not be added.";
                return;
            }

            if (stamp == _serverStamp)
            {
                ApplyCard(current => BoardView.Add(current, new CardAdded(current.Id, columnId, card)));
            }

            CloseCardForm();
        }
        catch (HttpRequestException)
        {
            if (!_disposed && _loadedId == Id)
            {
                cardError = "The card could not be added.";
            }
        }
        finally
        {
            _saving = false;

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private void OpenAdd(Guid columnId)
    {
        _formColumnId = columnId;
        _formCardId = null;
        _formTitle = "";
        _formDescription = "";
        _deleteId = null;
        cardError = null;
    }

    private void OpenEdit(CardResponse card)
    {
        var columnId = board?.Columns.FirstOrDefault(column => column.Cards.Any(item => item.Id == card.Id))?.Id;
        if (columnId is null)
        {
            return;
        }

        _formColumnId = columnId;
        _formCardId = card.Id;
        _formTitle = card.Title;
        _formDescription = card.Description ?? "";
        _deleteId = null;
        cardError = null;
    }

    private void CloseCardForm()
    {
        _formColumnId = null;
        _formCardId = null;
        cardError = null;
    }

    private async Task SubmitCardForm(Guid columnId)
    {
        if (_formCardId is null)
        {
            await AddCard(columnId);
        }
        else
        {
            await SaveCard();
        }
    }

    private void OpenDelete(CardResponse card)
    {
        CloseCardForm();
        _deleteId = card.Id;
        _deleteTitle = card.Title;
        cardError = null;
    }

    private void CloseDelete() => _deleteId = null;

    private void OnDialogKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !_saving)
        {
            CloseCardForm();
            CloseDelete();
        }
    }

    private async Task SaveCard()
    {
        if (_saving || _disposed || board is null || _formCardId is null)
        {
            return;
        }

        var cardId = _formCardId.Value;
        var stamp = _serverStamp;
        _saving = true;
        cardError = null;

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/cards/{cardId}",
                new { title = _formTitle, description = _formDescription });

            if (_disposed || _loadedId != Id)
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                cardError = await Relay.Client.Auth.ApiErrors.ReadAsync(response);
                return;
            }

            var card = await response.Content.ReadFromJsonAsync<CardResponse>();
            var columnId = board.Columns.FirstOrDefault(column => column.Cards.Any(item => item.Id == cardId))?.Id;

            if (card is null || columnId is null)
            {
                cardError = "The card could not be saved.";
                return;
            }

            if (stamp == _serverStamp)
            {
                ApplyCard(current => BoardView.Update(current, new CardUpdated(current.Id, columnId.Value, card)));
            }

            CloseCardForm();
        }
        catch (HttpRequestException)
        {
            if (!_disposed && _loadedId == Id)
            {
                cardError = "The card could not be saved.";
            }
        }
        finally
        {
            _saving = false;

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private async Task DeleteCard(Guid cardId)
    {
        if (_saving || _disposed || board is null)
        {
            return;
        }

        var stamp = _serverStamp;
        var column = board.Columns.FirstOrDefault(item => item.Cards.Any(card => card.Id == cardId));
        _saving = true;
        cardError = null;

        try
        {
            var response = await Http.DeleteAsync($"api/cards/{cardId}");

            if (_disposed || _loadedId != Id)
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                cardError = await Relay.Client.Auth.ApiErrors.ReadAsync(response);
                return;
            }

            if (stamp == _serverStamp && column is not null)
            {
                var orders = column.Cards
                    .Where(card => card.Id != cardId)
                    .OrderBy(card => card.Order)
                    .Select((card, index) => new CardOrderResponse(card.Id, column.Id, index))
                    .ToList();
                ApplyCard(current => BoardView.Delete(current, new CardDeleted(current.Id, column.Id, cardId, orders)));
            }

            CloseDelete();
        }
        catch (HttpRequestException)
        {
            if (!_disposed && _loadedId == Id)
            {
                cardError = "The card could not be deleted.";
            }
        }
        finally
        {
            _saving = false;

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private static bool AlreadyThere(BoardResponse board, Guid cardId, Guid columnId, int index)
    {
        var column = board.Columns.FirstOrDefault(item => item.Cards.Any(card => card.Id == cardId));

        if (column is null || column.Id != columnId)
        {
            return false;
        }

        var current = column.Cards.OrderBy(card => card.Order).Select(card => card.Id).ToList().IndexOf(cardId);
        return current == index;
    }

    private static string Initial(string name)
    {
        var trimmed = name.Trim();
        return trimmed.Length == 0 ? "?" : char.ToUpperInvariant(trimmed[0]).ToString();
    }
}
