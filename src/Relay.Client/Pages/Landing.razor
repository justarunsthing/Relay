@page "/"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Relay</PageTitle>

<section class="landing">
    <div class="landing-hero">
        <div>
            <h1>Boards that move when your team does.</h1>
            <p class="lede">
                Drag a card and everyone watching the board sees it land.
                See who is here, and pick up where you left off after a dropped connection.
            </p>
            <div class="hero-actions">
                <AuthorizeView>
                    <Authorized>
                        <a class="button" href="/boards">Your boards</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="button" href="/register">Create a board</a>
                        <a class="button quiet" href="/login?returnUrl=/boards">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <div class="mini-board" aria-hidden="true">
            <div>
                <p>To do</p>
                <span>Draft announcement</span>
                <span>Set up database</span>
            </div>
            <div>
                <p>In progress</p>
                <span class="lifted">Polish drag and drop</span>
            </div>
            <div>
                <p>Done</p>
                <span>Registration</span>
            </div>
        </div>
    </div>

    <section class="overview" aria-label="What Relay does">
        <article>
            <h2>Live moves</h2>
            <p>Every card change reaches the board group the moment it is saved.</p>
        </article>
        <article>
            <h2>Who is here</h2>
            <p>Display names sit under the title. Two tabs for one person count once.</p>
        </article>
        <article>
            <h2>Stays on screen</h2>
            <p>If the network drops, the board stays visible under a reconnecting banner, then syncs with the server.</p>
        </article>
    </section>
</section>
